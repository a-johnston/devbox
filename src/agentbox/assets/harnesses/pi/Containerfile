ARG RUNTIME_IMAGE
FROM node:24.14.0-bookworm-slim AS node
FROM ${RUNTIME_IMAGE}
COPY --from=node /usr/local/ /usr/local/
ARG PI_VERSION=1.3.0
# Build tools support native Linux dependencies in selected Pi extension packages.
RUN apt-get update && apt-get install -y --no-install-recommends build-essential python3-venv \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g --ignore-scripts @earendil-works/pi-coding-agent@${PI_VERSION}
