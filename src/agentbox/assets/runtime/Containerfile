ARG PROJECT_IMAGE
FROM ${PROJECT_IMAGE}
USER root
# safe.directory: shared checkouts are owned by a host UID the guest user lacks.
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash ca-certificates git less ripgrep tmux \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 agent \
    && useradd --create-home --uid 10001 --gid 10001 --shell /bin/bash agent \
    && git config --system safe.directory '*'
ENV HOME=/home/agent TERM=tmux-256color
WORKDIR /home/agent
# The harness runs in tmux via exec; the container only needs to stay alive.
ENTRYPOINT ["sleep", "infinity"]
